import turtle
from PIL import Image

# ============================================================
# LORD JAGANNATH - IMAGE TO TURTLE
# ============================================================

IMAGE_FILE = "jagannath.png"

# Higher = more detail, but slower
WIDTH = 280

# Number of colors
COLORS = 128

# ============================================================
# CREATE SCREEN
# ============================================================

screen = turtle.Screen()
screen.setup(900, 1000)
screen.title("Lord Jagannath - Turtle Art")

# IMPORTANT:
# Pillow gives RGB values from 0 to 255.
# Turtle must therefore use 0-255 color mode.
screen.colormode(255)

screen.bgcolor("black")

# Turn off animation for faster drawing
screen.tracer(0, 0)

# ============================================================
# LOAD IMAGE
# ============================================================

image = Image.open(r"C:\Users\Dell\OneDrive\Documents\Projects\Turtle\jaganath\jaganath.png").convert("RGB")

original_width, original_height = image.size

# Preserve original aspect ratio
height = round(
    WIDTH * original_height / original_width
)

image = image.resize(
    (WIDTH, height),
    Image.Resampling.LANCZOS
)

# Reduce colors
image = image.quantize(
    colors=COLORS,
    method=Image.Quantize.MEDIANCUT
).convert("RGB")

pixels = image.load()

# ============================================================
# CALCULATE DRAWING SIZE
# ============================================================

screen_width = 900
screen_height = 1000

margin = 20

available_width = screen_width - margin * 2
available_height = screen_height - margin * 2

scale_x = available_width / WIDTH
scale_y = available_height / height

scale = min(scale_x, scale_y)

draw_width = WIDTH * scale
draw_height = height * scale

cell_width = scale
cell_height = scale

# ============================================================
# TURTLE
# ============================================================

pen = turtle.Turtle()

pen.hideturtle()
pen.penup()
pen.shape("square")

# ============================================================
# DRAW
# ============================================================

left = -draw_width / 2
top = draw_height / 2

for row in range(height):

    y = top - (row + 0.5) * cell_height

    for col in range(WIDTH):

        r, g, b = pixels[col, row]

        # Skip pure black background
        if r < 3 and g < 3 and b < 3:
            continue

        x = left + (col + 0.5) * cell_width

        pen.goto(x, y)

        # RGB 0-255 because screen.colormode(255)
        pen.color(r, g, b)

        # Make the Turtle stamp approximately
        # the same size as one image pixel
        pen.shapesize(
            stretch_wid=max(cell_height / 20, 0.05),
            stretch_len=max(cell_width / 20, 0.05)
        )

        pen.stamp()

    # Refresh every 5 rows
    if row % 5 == 0:
        screen.update()

# ============================================================
# FINISH
# ============================================================

screen.update()

turtle.done()
